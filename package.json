{
  "name": "brave-comic-reader",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "download:archivefs": "sh scripts/download-archivefs.sh",
    "download:pdfium": "sh scripts/download-pdfium.sh",
    "tauri:dev": "npm run download:archivefs && npm run download:pdfium && tauri dev",
    "tauri:build": "npm run download:archivefs && npm run download:pdfium && tauri build",
    "tauri:release": "npm run download:archivefs && npm run download:pdfium && tauri build --no-bundle",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.4",
    "@tailwindcss/typography": "0.5.20",
    "@tauri-apps/cli": "^2.11.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "6.7.0",
    "@typescript-eslint/parser": "6.7.0",
    "@vitejs/plugin-react": "4.3.0",
    "autoprefixer": "10.4.19",
    "daisyui": "^4.12.0",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "postcss": "8.4.35",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "vite": "5.4.0"
  }
}
